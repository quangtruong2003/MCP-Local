{
  "name": "local-workspace-mcp-manager",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "test": "vitest run",
    "build:sidecar": "powershell -ExecutionPolicy Bypass -File scripts/build-tailscale-sidecar.ps1",
    "verify:lightpanda-runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-lightpanda-runtime-manifest.ps1",
    "verify:browser-release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-browser-release.ps1",
    "validate:skill": "python scripts/validate-agent-skill.py",
    "package:skill": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-agent-skill.ps1",
    "verify": "npm run validate:skill && npm run build && npm run build:sidecar"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "lucide-react": "^1.34.0",
    "radix-ui": "^1.6.7",
    "react": "^18",
    "react-dom": "^18",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.3.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "^5",
    "vitest": "4.1.11"
  }
}
