{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Workspace MCP Manager",
  "version": "0.2.2",
  "identifier": "com.local.workspace-mcp-manager",
  "build": {
    "beforeDevCommand": "npm run build:sidecar && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:sidecar && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Local Workspace MCP Manager",
        "width": 980,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/tailscale-funnel-sidecar"
    ],
    "resources": [
      "binaries/TAILSCALE-LICENSE.txt",
      "resources/lightpanda-runtime-manifest.json"
    ]
  }
}